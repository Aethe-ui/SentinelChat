<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep_navy"
    tools:context=".MainActivity">

    <!-- Background Decoration (Particle/Network pattern feel) -->
    <View
        android:layout_width="400dp"
        android:layout_height="400dp"
        android:layout_marginTop="-150dp"
        android:layout_marginEnd="-150dp"
        android:alpha="0.05"
        android:background="@drawable/glass_background"
        android:rotation="15"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:alpha="0"> <!-- Animated in onCreate -->

            <!-- 1. Top Section -->
            <ImageView
                android:id="@+id/iv_logo"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="32dp"
                android:contentDescription="@string/logo_description"
                android:src="@drawable/ic_logo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-condensed"
                android:text="@string/app_name"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iv_logo" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.1"
                android:text="@string/private_direct_session"
                android:textColor="@color/accent_cyan"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_app_name" />

            <!-- 2. Main Card Container -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/session_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:background="@drawable/glass_background"
                android:elevation="8dp"
                android:padding="20dp"
                app:layout_constraintTop_toBottomOf="@id/tv_subtitle">

                <TextView
                    android:id="@+id/tv_card_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/start_secure_session"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_session_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/session_description"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_card_title" />

                <!-- 3. User Identity Field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_display_name"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:hint="@string/display_name"
                    android:textColorHint="@color/text_secondary"
                    app:boxStrokeColor="@color/accent_neon_blue"
                    app:helperText="@string/display_name_helper"
                    app:helperTextTextColor="@color/text_secondary"
                    app:hintTextColor="@color/accent_neon_blue"
                    app:startIconDrawable="@android:drawable/ic_menu_myplaces"
                    app:startIconTint="@color/accent_neon_blue"
                    app:layout_constraintTop_toBottomOf="@id/tv_session_desc">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_display_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:textColor="@color/white" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 4. WiFi Status Indicator -->
                <LinearLayout
                    android:id="@+id/wifi_status_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@id/til_display_name">

                    <ImageView
                        android:id="@+id/iv_wifi_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_wifi"
                        app:tint="@color/accent_neon_blue" />

                    <TextView
                        android:id="@+id/tv_wifi_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/wifi_warning"
                        android:textColor="@color/error_red"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 5. Primary Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_initialize"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/initialize_session"
                    android:textColor="@color/bg_deep_navy"
                    android:textStyle="bold"
                    app:backgroundTint="@color/accent_neon_blue"
                    app:cornerRadius="12dp"
                    android:enabled="false"
                    app:layout_constraintTop_toBottomOf="@id/wifi_status_container" />

                <ProgressBar
                    android:id="@+id/pb_loading"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:visibility="gone"
                    android:indeterminateTint="@color/bg_deep_navy"
                    app:layout_constraintBottom_toBottomOf="@id/btn_initialize"
                    app:layout_constraintEnd_toEndOf="@id/btn_initialize"
                    app:layout_constraintStart_toStartOf="@id/btn_initialize"
                    app:layout_constraintTop_toTopOf="@id/btn_initialize" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 6. Optional Small Text Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_advanced"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/advanced_settings"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/session_card" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>